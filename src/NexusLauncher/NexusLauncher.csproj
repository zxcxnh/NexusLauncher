<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Self‑contained publish (optional, uncomment for release) -->
    <!-- <PublishSingleFile>true</PublishSingleFile> -->
    <!-- <SelfContained>true</SelfContained> -->
    <!-- <RuntimeIdentifier>win-x64</RuntimeIdentifier> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.0" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.39" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Page Include="Views\HomeView.xaml" />
    <Page Include="Views\SettingsView.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="Views\HomeView.xaml.cs" />
    <Compile Include="Views\SettingsView.xaml.cs" />
    <Compile Include="ViewModels\MainWindowViewModel.cs" />
    <Compile Include="ViewModels\HomeViewModel.cs" />
    <Compile Include="ViewModels\SettingsViewModel.cs" />
    <Compile Include="Models\Game.cs" />
    <Compile Include="Services\IDbService.cs" />
    <Compile Include="Services\DbService.cs" />
    <Compile Include="Services\ISettingsService.cs" />
    <Compile Include="Services\SettingsService.cs" />
    <Compile Include="Infrastructure\NavigationService.cs" />
    <Compile Include="Infrastructure\ThemeManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Themes\Dark.xaml" />
    <Resource Include="Resources\Themes\Light.xaml" />
  </ItemGroup>

</Project>
