<UserControl x:Class="NexusLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NexusLauncher.ViewModels"
             DataContext="{Binding SettingsVM, RelativeSource={RelativeSource Self}}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Appearance"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="Theme:" Width="80" VerticalAlignment="Center"/>
                <ComboBox Width="150"
                          ItemsSource="{Binding AvailableThemes}"
                          SelectedItem="{Binding SelectedTheme}"
                          Margin="4,0"/>
                <Button Content="Apply"
                        Command="{Binding ApplyThemeCommand}"
                        Margin="8,0"/>
            </StackPanel>

            <!-- Future appearance options (accent colour, scaling, etc.) could go here -->
        </StackPanel>
    </Grid>
</UserControl>
