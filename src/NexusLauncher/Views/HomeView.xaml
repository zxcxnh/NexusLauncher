<UserControl x:Class="NexusLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NexusLauncher.ViewModels"
             xmlns:local="clr-namespace:NexusLauncher.Views"
             DataContext="{Binding HomeVM, RelativeSource={RelativeSource Self}}">

    <UserControl.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    VerticalAlignment="Center">
            <TextBlock Text="Your Library"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}"
                       Margin="4"/>
            <Button Content="Add Game"
                    Command="{Binding AddGameCommand}"
                    Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Main list (empty placeholder for now) -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Your library is empty."
                           FontSize="16"
                           Foreground="{DynamicResource ForegroundBrush}"
                           HorizontalAlignment="Center"/>
                <Button Content="Add a game"
                        Command="{Binding AddGameCommand}"
                        Margin="0,12,0,0"
                        Width="120"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
